# Copie este arquivo para `.env` e preencha. O `.env` NUNCA vai para o GitHub.
# Os mesmos valores devem ser cadastrados como GitHub Secrets (ver directives/setup_meta_app.md).

# ID numerico da sua conta Instagram Business (obtido no passo 5 da diretiva de setup)
IG_USER_ID=

# Page Access Token de longa duracao (nao expira). Passo 4 da diretiva de setup.
IG_ACCESS_TOKEN=

# App ID e App Secret do app Meta. Usados apenas pelos scripts de token,
# NAO sao necessarios para publicar.
META_APP_ID=
META_APP_SECRET=

# Versao da Graph API. Opcional - o padrao ja e a versao atual.
GRAPH_API_VERSION=v25.0

# URL base publica de onde a Meta vai baixar as artes.
# No GitHub Actions isso e preenchido automaticamente; so preencha para testes locais.
# Formato: https://raw.githubusercontent.com/<usuario>/<repo>/<branch>/imagens
BASE_URL_IMAGENS=
